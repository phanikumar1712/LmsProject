# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── NeonDB PostgreSQL Connection String ───────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Docker (nginx):  http://localhost
# Local dev:       http://localhost:5173
# Mobile testing:  http://<your-local-ip>:5173
FRONTEND_URL=http://localhost

# ── Cloudinary (for thumbnail & lesson file uploads) ──────────────────────────
# Get credentials from https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend Mail (for OTP & Forgot Password) ───────────────────────────────────
# Get API Key from https://resend.com/ → API Keys → Create API Key
# Free tier: 100 emails/day
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Optional: Default demo accounts (created by migration seed) ───────────────
# Run `npm run migrate` to create these accounts automatically:
#   SUPER_ADMIN:  superadmin@lms.com / superadmin
#   All others:   <role>.<dept>@demo.com / demo123
