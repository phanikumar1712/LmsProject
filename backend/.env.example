# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── NeonDB PostgreSQL Connection String ───────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Docker (nginx):  http://localhost
# Local dev:       http://localhost:5173
# Mobile testing:  http://<your-local-ip>:5173
FRONTEND_URL=http://localhost

# ── Cloudinary (for thumbnail & lesson file uploads) ──────────────────────────
# Get credentials from https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend Mail (for OTP & Forgot Password) ───────────────────────────────────
# Get API Key from https://resend.com/ → API Keys → Create API Key
# Free tier: 100 emails/day
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── SUPER ADMIN ──────────────────────────────────────────────────────────────
# REQUIRED in production (NODE_ENV=production): `npm run migrate` FAILS HARD
# without it — a live deployment must never run with a known default password
# or zero super admins. When set in production it is also applied to an
# existing account, so any pre-fix super admin seeded with the legacy
# 'superadmin' default is automatically rotated. Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# In dev/test (NODE_ENV != production) the super admin falls back to
# 'superadmin' and demo accounts are seeded for convenience.
SUPER_ADMIN_PASSWORD=change_me_to_a_strong_password

# ── Demo accounts (dev/test only) ────────────────────────────────────────────
# Created by the migration ONLY when NODE_ENV != production:
#   SUPER_ADMIN:  superadmin@lms.com (password from SUPER_ADMIN_PASSWORD above)
#   All others:   <role>.<dept>@demo.com / demo123
# In production the migration DELETES any pre-existing *@demo.com accounts
# (healing databases migrated before this hardening) and demo login
# (/api/auth/demo) is DISABLED, exposing only STUDENT / INSTRUCTOR roles.
